<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_password_reset"
    app:startDestination="@id/sendEmailFragment">

    <activity
        android:id="@+id/loginActivity2"
        android:name="com.eat.jani.activities.auth.LoginActivity"
        android:label="LoginActivity" />
    <fragment
        android:id="@+id/sendEmailFragment"
        android:name="com.eat.jani.fragments.auth.SendEmailFragment"
        android:label="SendEmailFragment" >
        <action
            android:id="@+id/action_sendEmailFragment_to_loginActivity2"
            app:destination="@id/loginActivity2" />
    </fragment>
    <fragment
        android:id="@+id/passwordResetFragment"
        android:name="com.eat.jani.fragments.auth.PasswordResetFragment"
        android:label="PasswordResetFragment" >
        <action
            android:id="@+id/action_passwordResetFragment_to_loginActivity2"
            app:destination="@id/loginActivity2" />
    </fragment>
</navigation>