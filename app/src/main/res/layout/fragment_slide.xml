<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="slide"
            type="com.eat.jani.models.starting.Slide" />
    </data>

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_color"
    tools:context=".fragments.starting.SlideFragment">

    <TextView
        android:id="@+id/wTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="148dp"
        android:gravity="center"
        android:text="@{slide.title}"
        android:textColor="@color/secondary"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <ImageView
        android:id="@+id/wImage"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        app:imageResource="@{slide.image}"
        app:layout_constraintEnd_toEndOf="@+id/wTitle"
        app:layout_constraintStart_toStartOf="@+id/wTitle"
        app:layout_constraintTop_toBottomOf="@+id/wTitle"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/wDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@{slide.desc}"
        android:textColor="@color/secondary"
        android:textSize="20sp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="@+id/wImage"
        app:layout_constraintStart_toStartOf="@+id/wImage"
        app:layout_constraintTop_toBottomOf="@+id/wImage"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>