<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.eat.jani.viewmodels.auth.RegisterViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".fragments.auth.VerifyFragment">

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="172dp"
                android:text="Verify Account"
                android:textColor="@color/secondary"
                android:textSize="32sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="64dp"
                android:layout_marginEnd="44dp"
                android:text="ვერიფიკაციისთვის კოდი გაიგზავნება თქვენს email - ზე"
                android:textColor="@color/secondary"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:layout_marginStart="10dp"
                android:text="@{viewModel.codeError}"
                android:textColor="#FFEB3B"
                android:textSize="12sp"
                app:layout_constraintBottom_toTopOf="@+id/verifyCodeInput"
                app:layout_constraintStart_toStartOf="@+id/verifyCodeInput"
                tools:ignore="HardcodedText" />

            <EditText
                android:id="@+id/verifyCodeInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/auth_input_back"
                android:hint="შეიყვანეთ კოდი"
                android:inputType="number"
                android:paddingHorizontal="10dp"
                android:text="@={viewModel.verificationCode}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                tools:ignore="Autofill,HardcodedText,TextFields" />


            <TextView
                android:id="@+id/sendCodeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:onClick="@{() -> viewModel.sendVerificationCode()}"
                android:text="@string/sendCode"
                android:textColor="@color/secondary"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="@+id/verifyCodeInput"
                app:layout_constraintTop_toBottomOf="@+id/verifyCodeInput"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:id="@+id/codeTimerTextLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:orientation="horizontal"
                android:visibility="invisible"
                app:layout_constraintStart_toStartOf="@+id/verifyBtn"
                app:layout_constraintTop_toBottomOf="@+id/verifyBtn">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="გაგზავნილი კოდი წაიშლება (წამებში): "
                    android:textColor="@color/secondary"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toStartOf="@+id/codeTimerTextView2"
                    app:layout_constraintTop_toBottomOf="@+id/verifyCodeInput"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/codeTimerTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="300"
                    android:textColor="@color/secondary"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="@+id/verifyCodeInput"
                    app:layout_constraintTop_toBottomOf="@+id/verifyCodeInput"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <Button
                android:id="@+id/verifyBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/welcome_btn"
                android:onClick="@{() -> viewModel.verifyCodeAndLogin()}"
                android:text="ვერიფიკაცია"
                android:textAllCaps="false"
                android:textColor="@color/primary_color"
                android:textSize="22sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sendCodeTextView"
                tools:ignore="HardcodedText" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/loadingAnimation"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:visibility="gone"
            app:lottie_autoPlay="false"
            app:lottie_loop="true"
            app:lottie_fileName="loading.json" />

    </FrameLayout>
</layout>