<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_note_graph"
    app:startDestination="@id/noteFragment">

    <fragment
        android:id="@+id/noteFragment"
        android:name="com.eat.jani.fragments.main.note.NoteFragment"
        android:label="NoteFragment" >
        <action
            android:id="@+id/action_noteFragment_to_addNoteFragment"
            app:destination="@id/addNoteFragment" />
        <action
            android:id="@+id/action_noteFragment_to_updateNoteFragment"
            app:destination="@id/updateNoteFragment" />
    </fragment>
    <fragment
        android:id="@+id/addNoteFragment"
        android:name="com.eat.jani.fragments.main.note.AddNoteFragment"
        android:label="AddNoteFragment" />
    <fragment
        android:id="@+id/updateNoteFragment"
        android:name="com.eat.jani.fragments.main.note.UpdateNoteFragment"
        android:label="UpdateNoteFragment" />
</navigation>