<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="meal"
            type="com.eat.jani.models.calculations.Meal" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginVertical="4dp"
        android:layout_marginHorizontal="2dp"
        android:paddingVertical="4dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvMealCalories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='@{"კალორიები: " + meal.mealCalories + "კკალ"}'
                android:textColor="@color/black"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvMealProtein"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='@{"ცილები: " + meal.protein + "გ"}'
                android:textColor="@color/black"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvMealCalories"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="4dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvMealCarbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='@{"ნახშირწყლები: " + meal.carbs + "გ"}'
                android:textColor="@color/black"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvMealProtein"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="4dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvMealFat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='@{"ცხიმები: " + meal.fat + "გ"}'
                android:textColor="@color/black"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvMealCarbs"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="4dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvMealTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='@{"დრო: " + meal.time + " სთ"}'
                android:textColor="@color/black"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvMealFat"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="4dp"
                tools:ignore="HardcodedText" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</layout>
